<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GlassCommander.FilePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassCommander"
    GotFocus="Pane_GotFocus">

    <UserControl.Resources>
        <!-- Kijelölés akcentusszínnel: az inaktív panelben is jól látszik, hol áll a kurzor -->
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.32" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.38" />

        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
        <Style x:Key="PaneIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Frame"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fülek -->
                <TabView x:Name="Tabs" Grid.Row="0"
                         VerticalAlignment="Top"
                         Background="Transparent"
                         Padding="2,4,2,0"
                         TabWidthMode="SizeToContent"
                         CloseButtonOverlayMode="OnPointerOver"
                         IsAddTabButtonVisible="True"
                         CanDragTabs="False"
                         CanReorderTabs="True"
                         AllowFocusOnInteraction="False"
                         AddTabButtonClick="Tabs_AddTabButtonClick"
                         TabCloseRequested="Tabs_TabCloseRequested"
                         SelectionChanged="Tabs_SelectionChanged" />

                <!-- Navigációs sor -->
                <Grid Grid.Row="1" Padding="8,6,8,6" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DriveBox" Grid.Column="0" MinWidth="78"
                              VerticalAlignment="Center"
                              SelectionChanged="DriveBox_SelectionChanged" />
                    <Button Grid.Column="1" Style="{StaticResource PaneIconButton}" Click="Back_Click"
                            ToolTipService.ToolTip="Vissza (Alt+Balra)">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PaneIconButton}" Click="Up_Click"
                            ToolTipService.ToolTip="Fel (Backspace)">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    </Button>
                    <TextBox x:Name="PathBox" Grid.Column="3" VerticalAlignment="Center"
                             KeyDown="PathBox_KeyDown" IsSpellCheckEnabled="False" />
                    <Button Grid.Column="4" Style="{StaticResource PaneIconButton}" Click="Refresh_Click"
                            ToolTipService.ToolTip="Frissítés (Ctrl+R)">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Oszlopfejléc -->
                <Grid Grid.Row="2" Padding="4,0,14,2"
                      BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="138" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="NameHeader" Grid.Column="0" Style="{StaticResource HeaderButton}" Tag="Name" Click="Header_Click" Content="Név" />
                    <Button x:Name="ExtHeader" Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="Ext" Click="Header_Click" Content="Kit." />
                    <Button x:Name="SizeHeader" Grid.Column="2" Style="{StaticResource HeaderButton}" Tag="Size" Click="Header_Click"
                            HorizontalContentAlignment="Right" Content="Méret" />
                    <Button x:Name="DateHeader" Grid.Column="3" Style="{StaticResource HeaderButton}" Tag="Date" Click="Header_Click" Content="Módosítva" />
                </Grid>

                <!-- Fájllista -->
                <ListView x:Name="FileList" Grid.Row="3"
                          SelectionMode="Extended"
                          IsDoubleTapEnabled="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          DoubleTapped="List_DoubleTapped"
                          RightTapped="List_RightTapped"
                          SelectionChanged="List_SelectionChanged"
                          DragItemsStarting="FileList_DragItemsStarting"
                          DragOver="FileList_DragOver"
                          Drop="FileList_Drop"
                          Padding="0,4,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Padding" Value="10,0,10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- Vékony, akcentusszínű kurzor a vastag fehér keret helyett -->
                            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
                            <Setter Property="FocusVisualPrimaryThickness" Value="1.5" />
                            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                            <Setter Property="FocusVisualMargin" Value="1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileItem">
                            <Grid Opacity="{x:Bind ItemOpacity}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="138" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Grid Width="18" Height="18">
                                        <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" FontSize="16"
                                                  Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="18" Height="18" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind BaseName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Extension}" VerticalAlignment="Center"
                                           Padding="6,0,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Padding="0,0,6,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind DateText}" VerticalAlignment="Center"
                                           Padding="6,0,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Gyorskereső (gépeléskor jelenik meg) -->
                <Border x:Name="SearchBox" Grid.Row="3"
                        Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="12" Padding="12,7,14,7" CornerRadius="8"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock x:Name="SearchText" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchHint" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Állapotsor -->
                <Grid Grid.Row="4" Padding="14,6,14,8"
                      BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="FreeText" Grid.Column="1" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Aktív panel kiemelése -->
        <Border x:Name="ActiveRing"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                IsHitTestVisible="False"
                Opacity="0" />
    </Grid>
</UserControl>
