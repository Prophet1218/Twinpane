<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlassCommander.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassCommander"
    Title="Keresés – Glass Commander">

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Címsor -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Keresés" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Keresési feltételek -->
        <Border Grid.Row="1" Margin="12,0,12,8" Padding="16,14,16,14" CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="PatternBox" Grid.Row="0" Grid.Column="0"
                         Header="Fájlnév"
                         PlaceholderText="pl. számla  vagy  *.pdf  vagy  *.jpg;*.png"
                         IsSpellCheckEnabled="False" KeyDown="Box_KeyDown" />
                <TextBox x:Name="ContentBox" Grid.Row="0" Grid.Column="1"
                         Header="Tartalmazza ezt a szöveget (nem kötelező)"
                         PlaceholderText="szöveg a fájlokon belül"
                         IsSpellCheckEnabled="False" KeyDown="Box_KeyDown" />

                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RootBox" Header="Hol keressen" IsSpellCheckEnabled="False" KeyDown="Box_KeyDown" />
                    <CheckBox x:Name="AllDrivesCheck" Grid.Column="1" VerticalAlignment="Bottom"
                              Content="Minden meghajtón" Click="AllDrives_Click" />
                </Grid>

                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SubfoldersCheck" Content="Almappákban is" IsChecked="True" />
                    <CheckBox x:Name="FoldersCheck" Grid.Column="1" Content="Mappák is" IsChecked="True" />
                    <CheckBox x:Name="HiddenCheck" Grid.Column="2" Content="Rejtett fájlok is" />
                    <Button x:Name="StartButton" Grid.Column="4" Style="{StaticResource AccentButtonStyle}"
                            MinWidth="140" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="StartIcon" Glyph="&#xE721;" FontSize="14" />
                            <TextBlock x:Name="StartText" Text="Keresés" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Állapot -->
        <Grid Grid.Row="2" Margin="16,0,16,6" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing x:Name="Busy" Width="16" Height="16" IsActive="False" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Add meg, mit keresel, majd nyomj Entert." />
        </Grid>

        <!-- Találatok -->
        <Border Grid.Row="3" Margin="12,0,12,12" CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="Results"
                      SelectionMode="Single"
                      IsDoubleTapEnabled="True"
                      DoubleTapped="Results_DoubleTapped"
                      KeyDown="Results_KeyDown"
                      RightTapped="Results_RightTapped"
                      Padding="0,4,0,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="12,2,12,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FileItem">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="138" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" FontSize="17"
                                          Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                                <Image Source="{x:Bind Icon, Mode=OneWay}" Width="20" Height="20" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Folder}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DateText}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>
